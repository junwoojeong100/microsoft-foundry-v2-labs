# Reference only. Generate your actual azure.yaml with the installed azd CLI.
# No subscription, existing resource ID, or model catalog name is guessed here.
name: microsoft-foundry-v2-labs
services:
  foundry-project:
    host: azure.ai.project
    endpoint: ${AZURE_AI_PROJECT_ENDPOINT}
  policy-guide:
    project: ./.build/hosted
    host: azure.ai.agent
    language: python
    uses:
      - foundry-project
    kind: hosted
    name: ${WORKSHOP_AGENT_NAME}
    description: Synthetic travel-policy guide. Read-only tools and no real company data.
    env:
      AZURE_AI_PROJECT_ENDPOINT: ${AZURE_AI_PROJECT_ENDPOINT}
      AZURE_AI_MODEL_DEPLOYMENT_NAME: ${AZURE_AI_MODEL_DEPLOYMENT_NAME}
      WORKSHOP_AUTH_MODE: managed-identity
      WORKSHOP_MAX_OUTPUT_TOKENS: "2048"
    codeConfiguration:
      runtime: python_3_13
      entryPoint: main.py
      dependencyResolution: remote_build
    container:
      resources:
        cpu: "1"
        memory: 2Gi
    protocols:
      - protocol: responses
        version: v1
infra:
  provider: microsoft.foundry
