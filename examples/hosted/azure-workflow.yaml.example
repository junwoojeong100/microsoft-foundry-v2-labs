# Reference only: adapt the generated agent service, not the entire azure.yaml.
# This profile exposes typed Invocations for the Hosted evaluation matrix.
services:
  workflow-evaluation:
    name: ${WORKSHOP_HOSTED_AGENT_NAME}
    project: ./.build/workflow-sequential-iq-v1-account-chat-invocations
    host: azure.ai.agent
    language: python
    kind: hosted
    env:
      AZURE_AI_PROJECT_ENDPOINT: ${AZURE_AI_PROJECT_ENDPOINT}
      AZURE_AI_MODEL_DEPLOYMENT_NAME: ${AZURE_AI_MODEL_DEPLOYMENT_NAME}
      AZURE_OPENAI_ENDPOINT: ${AZURE_OPENAI_ENDPOINT}
      WORKSHOP_MODEL_DEPLOYMENTS_JSON: ${WORKSHOP_MODEL_DEPLOYMENTS_JSON}
      WORKSHOP_AUTH_MODE: managed-identity
      WORKSHOP_MAX_OUTPUT_TOKENS: "2048"
      WORKSHOP_PREFIX: ${WORKSHOP_PREFIX}
      AZURE_SEARCH_ENDPOINT: ${AZURE_SEARCH_ENDPOINT}
      AZURE_SEARCH_INDEX_NAME: ${AZURE_SEARCH_INDEX_NAME}
      AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME: ${AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME}
      AZURE_SEARCH_KNOWLEDGE_BASE_NAME: ${AZURE_SEARCH_KNOWLEDGE_BASE_NAME}
      WORKSHOP_IQ_RERANKER_THRESHOLD: ${WORKSHOP_IQ_RERANKER_THRESHOLD}
    codeConfiguration:
      runtime: python_3_13
      entryPoint: main.py
      dependencyResolution: remote_build
    protocols:
      - protocol: invocations
        version: 1.0.0
