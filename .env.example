# Copy this file to .env. Never put passwords, API keys, or tokens here.
# Use the exact project endpoint and deployment name provided by your instructor.
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=

# cli for local development; managed-identity only inside an Azure-hosted runtime.
# This selects the Python caller, not the Search service's outbound model identity.
WORKSHOP_AUTH_MODE=cli
AZURE_CLIENT_ID=
WORKSHOP_PREFIX=
WORKSHOP_MAX_OUTPUT_TOKENS=2048

# Optional: required only for Search / Foundry IQ labs.
AZURE_SEARCH_ENDPOINT=
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME=
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=
# IQ Chat model / Search managed identity are configured on the knowledge base.
# See docs/reference/iq-model-identity.md; seed-search does not read planner env placeholders.

# Optional: explicit account-chat mode. Must be the same Foundry account.
# Leaving this blank never enables an endpoint fallback.
AZURE_OPENAI_ENDPOINT=

# Optional hybrid retrieval: exact existing embedding deployment and its actual dimensions.
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=
WORKSHOP_EMBEDDING_DIMENSIONS=
# Set explicitly to account for the same account's OpenAI v1 embeddings API.
# project remains a distinct contract; errors never trigger an automatic switch.
WORKSHOP_EMBEDDING_API=account
# Optional IQ retrieval filter, not an evaluator threshold. Empty uses the service default.
# A value of 0 retained all six documents in the English synthetic recall experiment.
WORKSHOP_IQ_RERANKER_THRESHOLD=

# Optional Hosted benchmark. Get name/version/Invocations endpoint from actual azd show output.
WORKSHOP_HOSTED_AGENT_NAME=
WORKSHOP_HOSTED_AGENT_VERSION=
WORKSHOP_HOSTED_AGENT_ENDPOINT=
# Uncomment only after replacing every value with a verified existing deployment.
# The AZURE_AI_MODEL_DEPLOYMENT_NAME value must be one of these deployments.
# WORKSHOP_MODEL_DEPLOYMENTS_JSON={"primary":"verified-primary","candidate-b":"verified-other"}

# Optional read-only trace verification: the connected Application Insights application ID.
AZURE_APPLICATION_INSIGHTS_APP_ID=

# Optional: required only for cloud LLM-judge evaluation.
AZURE_AI_EVALUATION_MODEL_DEPLOYMENT_NAME=
