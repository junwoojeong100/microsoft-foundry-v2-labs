# Copy this file to .env. Never put passwords, API keys, or tokens here.
# Use the exact project endpoint and deployment name provided by your instructor.
# Offline doctor/demo/local retrieve/evaluate do not read .env or need these values.
# Existing process variables take precedence over .env. Never shell-source this file.

# 1. First live call: fill the setup-card values below (Lab 00/02).
AZURE_SUBSCRIPTION_ID=
AZURE_TENANT_ID=
AZURE_RESOURCE_GROUP=
AZURE_AI_ACCOUNT_NAME=
AZURE_AI_PROJECT_ENDPOINT=
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-6-sol

# Required before creating agent/Search objects: mfv2-<alias>-<date>, max 32 characters.
# Lowercase letters/digits and single hyphens only; no trailing hyphen.
# Choose one prefix/language per Search-owning copy. A new run label does not reset ownership.
WORKSHOP_PREFIX=

# Keep these defaults for the first pass.
# This selects the Python caller, not the Search service's outbound model identity.
WORKSHOP_AUTH_MODE=cli
WORKSHOP_MAX_OUTPUT_TOKENS=2048

# 2. Core B Lab 06: add the prepared Search service endpoint.
# A's inline-source route and Lab 07's local-retrieval experiment do not need it.
AZURE_SEARCH_ENDPOINT=

# STOP HERE for the default B route. The following fields are only for selected
# advanced modules or explicit object-name overrides; do not fill them all in.

# 3. Optional Search names and IQ Chat.
# Optional when Search is in a different resource group from the Foundry account.
AZURE_SEARCH_RESOURCE_GROUP=
# Blank object names use WORKSHOP_PREFIX; --language does not append en/ko to them.
# After seeding, preserve outputs/azure-objects.json. A language/prefix change needs a
# fresh source copy and new owned names, not deletion or editing of the old ledger.
AZURE_SEARCH_INDEX_NAME=
AZURE_SEARCH_KNOWLEDGE_SOURCE_NAME=
AZURE_SEARCH_KNOWLEDGE_BASE_NAME=
# Separate ready-to-chat base. Default: <WORKSHOP_PREFIX>-chat-<language>-kb.
AZURE_SEARCH_CHAT_KNOWLEDGE_BASE_NAME=
# IQ Chat model / Search managed identity are configured on the knowledge base.
# iq-chat setup pins gpt-5.6-luna (2026-07-09), Search SMI, low and answerSynthesis.
# Search knowledge bases accepted no GPT-6 model on 2026-09-23, so IQ Chat needs its own gpt-5.6-luna deployment.
# Run iq-chat check first. No model or role is created automatically.

# Optional managed Toolbox over the same six synthetic Search documents.
# The owner prepares a keyless CognitiveSearch connection in this Foundry project.
TOOLBOX_SEARCH_CONNECTION_NAME=
# Default: <WORKSHOP_PREFIX>-tools-<language>. Existing unowned names are rejected.
TOOLBOX_NAME=

# Required for iq-chat or explicit account-chat / account embeddings.
# Must be the same Foundry account; use https://<account>.openai.azure.com.
# Leaving this blank never enables an endpoint fallback.
AZURE_OPENAI_ENDPOINT=

# Optional hybrid retrieval: exact existing embedding deployment and its actual dimensions.
AZURE_AI_EMBEDDING_DEPLOYMENT_NAME=
WORKSHOP_EMBEDDING_DIMENSIONS=
# Set explicitly to account for the same account's OpenAI v1 embeddings API.
# project remains a distinct contract; errors never trigger an automatic switch.
WORKSHOP_EMBEDDING_API=account
# Optional IQ retrieval filter, not an evaluator threshold. Empty uses the service default.
# A value of 0 retained all six documents in the English synthetic recall experiment.
WORKSHOP_IQ_RERANKER_THRESHOLD=

# Optional Hosted benchmark. Get name/version/Invocations endpoint from actual azd show output.
WORKSHOP_HOSTED_AGENT_NAME=
WORKSHOP_HOSTED_AGENT_VERSION=
WORKSHOP_HOSTED_AGENT_ENDPOINT=
# Only for a user-assigned managed identity in an actual Azure runtime.
# Leave blank locally. Set WORKSHOP_AUTH_MODE=managed-identity only in that runtime.
AZURE_CLIENT_ID=
# Uncomment only after replacing every value with a verified existing deployment.
# The AZURE_AI_MODEL_DEPLOYMENT_NAME value must be one of these deployments.
# WORKSHOP_MODEL_DEPLOYMENTS_JSON={"primary":"verified-primary","candidate-b":"verified-other"}

# Optional read-only trace verification: the connected Application Insights application ID.
AZURE_APPLICATION_INSIGHTS_APP_ID=

# Optional: required only for cloud LLM-judge evaluation.
AZURE_AI_EVALUATION_MODEL_DEPLOYMENT_NAME=
